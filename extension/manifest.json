{
    "manifest_version": 3,
    "name": "FashionHelper",
    "version": "1.0",
    "description": "Streamline online fashion shopping with price comparisons and coupons.",
    "permissions": ["storage", "activeTab", "scripting"],
    "host_permissions": [
      "https://*.amazon.com/*",
      "https://*.flipkart.com/*",
      "https://*.myntra.com/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": "icons/shopping-cart-2-48.png"
    },
    "icons": {
      "16": "icons/shopping-cart-2-16.png",
      "48": "icons/shopping-cart-2-48.png",
      "128": "icons/shopping-cart-2-128.png"
    }
  }
  